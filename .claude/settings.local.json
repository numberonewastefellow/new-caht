{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "PowerShell",
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "Bash(docker:*)",
      "PowerShell(docker:*)",
      "Bash(docker run:*)",
      "PowerShell(docker run:*)",
      "Bash(docker compose:*)",
      "PowerShell(docker compose:*)",
      "Bash(docker-compose:*)",
      "PowerShell(docker-compose:*)",
      "Bash(docker logs:*)",
      "PowerShell(docker logs:*)",
      "Bash(docker exec:*)",
      "PowerShell(docker exec:*)"
    ]
  }
}
