## Search engine selection (Vespa / OpenSearch)
# Both engine containers are gated by compose profiles, so COMPOSE_PROFILES is how
# you turn each engine ON/OFF permanently (no leftover container):
#   "vespa"      -> starts the Vespa (index) container
#   "opensearch" -> starts the OpenSearch container
# Pick ONE of the three modes (always keep "s3-filestore" so MinIO works):
#   [A] Vespa only (default):   COMPOSE_PROFILES=s3-filestore,vespa
#   [B] Both engines:           COMPOSE_PROFILES=s3-filestore,vespa,opensearch
#   [C] OpenSearch only:        COMPOSE_PROFILES=s3-filestore,opensearch
#
# OpenSearch container tuning:
# OPENSEARCH_IMAGE_TAG=3.6.0
# OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g          # ~50% of the container memory limit
# OPENSEARCH_ADMIN_PASSWORD=StrongPassword123!  # OpenSearch 2.12+ requires a STRONG password
#
# Backend connection (defaults already point at the compose service):
# OPENSEARCH_HOST=opensearch
# OPENSEARCH_USE_SSL=true
#
# Engine behaviour (set with mode [B] / [C]):
# ENABLE_OPENSEARCH_INDEXING_FOR_ONYX=false   # true = also index documents into OpenSearch
# ONYX_DISABLE_VESPA=false                    # true = OpenSearch-only (mode [C]); switch retrieval FIRST
# ENABLE_OPENSEARCH_RETRIEVAL_FOR_ONYX=false  # fallback default for the retrieval engine.
#   NOTE: retrieval engine is a runtime DB-backed toggle (admin API
#   PUT /admin/opensearch-migration/retrieval); this env var is only the fallback.
# DISABLE_OPENSEARCH_MIGRATION_TASK=false     # true = skip the Vespa->OpenSearch backfill task;
#   set on a BRAND-NEW OpenSearch-only system (no Vespa corpus to migrate).
#
# Disable BOTH engines entirely (no connectors / RAG; chat + tools still work):
# DISABLE_VECTOR_DB=true
