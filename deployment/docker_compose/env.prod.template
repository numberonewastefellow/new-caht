# Fill in the values and copy the contents of this file to .env in the deployment directory.
# Some valid default values are provided where applicable, delete the variables which you don't set values for.
# This is only necessary when using the docker-compose.prod.yml compose file.


# Could be something like onyx.companyname.com
WEB_DOMAIN=http://localhost:3000

# The following are for configuring User Authentication, supported flows are:
# disabled
# basic (standard username / password)
# google_oauth (login with google/gmail account)
# oidc
# saml
AUTH_TYPE=google_oauth

# Set the values below to use with Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SECRET=

# if using basic auth and you want to require email verification, 
# then uncomment / set the following
#REQUIRE_EMAIL_VERIFICATION=true
#SMTP_USER=your-email@company.com
#SMTP_PASS=your-gmail-password

# The below are only needed if you aren't using gmail as your SMTP
#SMTP_SERVER=  
#SMTP_PORT=
# When missing SMTP_USER, this is used instead
#EMAIL_FROM=

# OpenID Connect (OIDC)
#OPENID_CONFIG_URL=

# SAML config directory for OneLogin compatible setups
#SAML_CONF_DIR=


# How long before user needs to reauthenticate, default to 7 days. (cookie expiration time)
SESSION_EXPIRE_TIME_SECONDS=604800


# Use the below to specify a list of allowed user domains, only checked if user Auth is turned on
# e.g. `VALID_EMAIL_DOMAINS=example.com,example.org` will only allow users
# with an @example.com or an @example.org email
#VALID_EMAIL_DOMAINS=


# Default values here are what Postgres uses by default, feel free to change.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password


# Default values here for the read-only user for the knowledge graph and other future read-only purposes. 
# Please change password!
DB_READONLY_USER=db_readonly_user
DB_READONLY_PASSWORD=password

# Show extra/uncommon connectors
# See the connectors section of your documentation for a full list of connectors
SHOW_EXTRA_CONNECTORS=False

# User File Upload Configuration
# Skip the token count threshold check (100,000 tokens) for uploaded files
# For self-hosted: set to true to skip for all users
#SKIP_USERFILE_THRESHOLD=false
# For multi-tenant: comma-separated list of tenant IDs to skip threshold
#SKIP_USERFILE_THRESHOLD_TENANT_IDS=


# Pulse (scheduled workflows)
# pulse_scheduler is an HA ticker loop (safe to run 2+ replicas); pulse_worker runs
# scheduled workflows from the `pulse` queue (scale with --scale pulse_worker=N).
# All values below are optional; the defaults shown are used when unset.
# Image for pulse_scheduler/pulse_worker (default: om/pulse:${IMAGE_TAG}).
# Honoured by docker-compose.yml; the prod compose files pin om/pulse:${IMAGE_TAG}.
#OM_PULSE_IMAGE=om/pulse:latest
# Number of pulse_scheduler replicas
#PULSE_SCHEDULER_REPLICAS=2
# How often each scheduler replica checks for due schedules (seconds)
#PULSE_TICK_SECONDS=5
# Shortest allowed interval between runs of one schedule (seconds)
#PULSE_MIN_INTERVAL_SECONDS=300
# Max schedules a single user may own
#PULSE_MAX_SCHEDULES_PER_USER=20
# Max concurrently pending/running scheduled runs per tenant (backpressure)
#PULSE_TENANT_MAX_CONCURRENT_RUNS=8
# A run may start at most this late (or half its period, whichever is larger), else it is skipped
#PULSE_MISFIRE_GRACE_SECONDS=300
# Auto-pause a schedule after this many failed runs in a row (0 disables)
#PULSE_MAX_CONSECUTIVE_FAILURES=5
# Default number of run chat sessions kept per schedule
#PULSE_DEFAULT_RETENTION=50
# Run history older than this many days is pruned
#PULSE_RUN_HISTORY_DAYS=90
# Threads per pulse_worker container (also sizes its DB pool)
#PULSE_WORKER_CONCURRENCY=4
# Worker heartbeat cadence, and how long without a heartbeat before a run is reaped (seconds)
#PULSE_HEARTBEAT_SECONDS=30
#PULSE_REAP_AFTER_SECONDS=90

# Code Interpreter (Python tool sandbox): shared secret between the code-interpreter
# service and api_server / background / pulse_worker. REQUIRED if the code interpreter
# runs - without it every /v1 call gets 503 (fail closed). Generate with
# `openssl rand -hex 32` and never commit the real value.
CODE_INTERPRETER_API_TOKEN=change-me
